    <Window x:Class="DictionaryMemorize.View.UserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UserView" Height="80" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="User" VerticalAlignment="Center" FontSize="15" Padding="10,5,10,5" Margin="10"/>
        <ComboBox Grid.Column="1" Text="{Binding User}" ItemsSource="{Binding Users}" SelectedItem="{Binding User}"
                  IsReadOnly="False" VerticalAlignment="Center">
            <ComboBox.IsEditable>
                <Binding ElementName="chIsEditable" Path="IsChecked"/>
            </ComboBox.IsEditable>
        </ComboBox>
        <CheckBox x:Name="chIsEditable" IsChecked="False" Grid.Column="2" Content="Direct Input" VerticalContentAlignment="Center"
                  VerticalAlignment="Center" Margin="10"/>
        <Button Grid.Column="3" Content="Ok" FontSize="15" Padding="10,1,10,1" IsDefault="True" Click="Button_Click_1" VerticalAlignment="Center"/>
    </Grid>
</Window>
